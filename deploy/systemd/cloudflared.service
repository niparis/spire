[Unit]
Description=Cloudflare Tunnel for Spire Linear webhooks
After=network-online.target spire.service
Wants=network-online.target
Requires=spire.service

[Service]
Type=simple
User=cloudflared
Group=cloudflared
LoadCredential=cloudflared-token:/etc/cloudflared/credentials/cloudflared-token
ExecStart=/bin/sh -ec 'exec /usr/bin/cloudflared --no-autoupdate tunnel --config /etc/cloudflared/config.yml run --token "$$(cat "$$CREDENTIALS_DIRECTORY/cloudflared-token")"'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
