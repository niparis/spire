[Unit]
Description=Spire SQLite online backup and retention
After=spire.service
Requires=spire.service

[Service]
Type=oneshot
User=spire
Group=spire
UMask=0077
ExecStart=/usr/local/bin/spire db backup-daily --config /etc/spire/spire.yaml
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/spire
